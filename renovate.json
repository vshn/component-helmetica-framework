{
  "extends": [
    "config:base",
    ":gitSignOff",
    ":disableDependencyDashboard"
  ],
  "ignorePaths": [
    ".github/**"
  ],
  "labels": [
    "dependency"
  ],
  "separateMinorPatch": true,
  "postUpgradeTasks": {
    "commands": [
      "make gen-golden-all"
    ],
    "fileFilters": [
      "tests/golden/**"
    ],
    "executionMode": "update"
  },
  "suppressNotifications": [
    "artifactErrors"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Alembic version in class/defaults.yml",
      "fileMatch": [
        "(^|/)class/defaults\\.yml$"
      ],
      "matchStrings": [
        "alembic_version: (?<currentValue>[^\\s#]+)"
      ],
      "datasourceTemplate": "github-tags",
      "depNameTemplate": "helmetica-framework/alembic"
    }
  ],
  "packageRules": [
    {
      "matchUpdateTypes": [
        "patch",
        "digest"
      ],
      "matchCurrentVersion": "!/^v?0\\./",
      "automerge": true,
      "platformAutomerge": false,
      "labels": [
        "dependency",
        "automerge",
        "bump:patch"
      ]
    }
  ]
}
